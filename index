<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Báo cáo Big Four</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{color-scheme:light;--pr:#1B3A6B;--prl:#14305A;--sc:#F5A623;--scl:#FFC966;--bg:#D8DCE8;--card:#fff;--txt:#1a1a2e;--txtl:#666;--bdr:#E5E7EB;--pos:#2E7D32;--neg:#D32F2F;}
body{font-family:'Segoe UI',Arial,sans-serif;background:var(--bg);color:var(--txt);font-size:13px;}
/* ── Header ── */
.header{background:var(--pr);color:#fff;padding:12px 22px;display:flex;align-items:center;gap:18px;box-shadow:0 2px 8px rgba(0,0,0,.35);}
.logo-box{border:2px solid var(--sc);border-radius:8px;padding:4px;display:flex;align-items:center;}
.logo-arco{font-size:26px;font-weight:900;color:var(--sc);letter-spacing:3px;line-height:1.1;}
.logo-living{font-size:10px;color:var(--sc);letter-spacing:5px;font-weight:700;}
.header-title{flex:1;}
.header-title h1{font-size:17px;font-weight:700;color:var(--sc);}
.header-title p{font-size:10px;color:rgba(255,255,255,.6);margin-top:2px;}
.proj-filter{display:flex;align-items:center;gap:6px;margin-right:10px;}
.proj-filter label{font-size:11px;color:rgba(255,255,255,.75);font-weight:600;}
.proj-filter select{padding:5px 10px;border:2px solid var(--sc);border-radius:4px;background:var(--pr);color:#fff;font-weight:700;font-size:12px;cursor:pointer;}
.proj-filter select option{color:#000;}
.year-tabs{display:flex;gap:8px;}
.year-btn{padding:6px 18px;border:2px solid var(--sc);border-radius:4px;background:transparent;color:var(--sc);font-weight:700;cursor:pointer;font-size:13px;transition:.2s;}
.year-btn.active{background:var(--sc);color:var(--pr);}
/* ── Nav ── */
.layout{display:flex;align-items:flex-start;}
.nav{background:var(--prl);display:flex;flex-direction:column;width:200px;flex-shrink:0;position:sticky;top:0;align-self:stretch;min-height:calc(100vh - 60px);border-right:3px solid var(--sc);padding-top:10px;}
.nav-btn{padding:12px 18px;color:rgba(255,255,255,.65);font-weight:600;cursor:pointer;border:none;background:transparent;font-size:13px;text-align:left;border-left:4px solid transparent;transition:.2s;line-height:1.35;}
.nav-btn:hover{color:#fff;background:rgba(255,255,255,.05);}
.nav-btn:focus-visible{outline:2px solid var(--sc);outline-offset:-2px;}
.nav-btn.active{color:var(--sc);border-left-color:var(--sc);background:rgba(245,166,35,.12);}
.main{flex:1;min-width:0;}
@media (max-width:760px){
  .layout{flex-direction:column;align-items:stretch;}
  .nav{flex-direction:row;width:auto;min-height:0;position:static;border-right:none;border-bottom:3px solid var(--sc);padding-top:0;overflow-x:auto;}
  .nav-btn{border-left:none;border-bottom:3px solid transparent;white-space:nowrap;}
  .nav-btn.active{border-bottom-color:var(--sc);}
  .chart-grid{grid-template-columns:1fr;}
  .chart-card{min-width:0;}
}
/* ── Pages ── */
.page{display:none;padding:18px 22px;}
.page.active{display:block;}
.section-title{font-size:14px;font-weight:700;color:var(--pr);border-left:4px solid var(--sc);padding-left:10px;margin:20px 0 12px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.section-title:first-child{margin-top:0;}
/* ── KPI Zones ── */
.kpi-zones{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;}
.kpi-zone{background:var(--card);border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,.09);overflow:hidden;}
.kpi-zone.rev-zone{border-left:5px solid var(--pr);}
.kpi-zone.cost-zone{border-left:5px solid var(--sc);}
.kzone-header{padding:9px 16px;font-size:12px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;}
.rev-zone .kzone-header{background:linear-gradient(90deg,rgba(27,58,107,.09),transparent);color:var(--pr);border-bottom:1px solid rgba(27,58,107,.12);}
.cost-zone .kzone-header{background:linear-gradient(90deg,rgba(245,166,35,.1),transparent);color:#B26A00;border-bottom:1px solid rgba(245,166,35,.22);}
.kzone-metrics{display:grid;grid-template-columns:1fr 1px 1fr 1px 1.15fr;align-items:stretch;padding:14px 0 10px;}
.kzm{padding:4px 18px;text-align:center;}
.kzm-divider{background:var(--bdr);align-self:stretch;}
.kzm-lbl{font-size:9.5px;text-transform:uppercase;letter-spacing:.5px;color:var(--txtl);margin-bottom:6px;font-weight:600;}
.kzm-val{font-size:22px;font-weight:800;color:var(--txt);line-height:1.15;}
.kzm-val.kzm-pct{font-size:34px;font-weight:900;}
.kzm-val.kzm-pct.good{color:var(--pos);}
.kzm-val.kzm-pct.bad{color:var(--neg);}
.kzm-sub{font-size:11px;margin-top:5px;color:var(--txtl);}
.kzm-sub.up{color:var(--pos);font-weight:600;}
.kzm-sub.down{color:var(--neg);font-weight:600;}
.kzone-footer{padding:8px 18px;background:#FAFAFA;border-top:1px solid var(--bdr);font-size:11px;color:var(--txtl);display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.kzf-sep{color:var(--bdr);margin:0 2px;}
.kzone-footer b{color:var(--txt);}
.kzone-footer b.up{color:var(--pos);}
.kzone-footer b.down{color:var(--neg);}
/* ── Charts ── */
.chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;}
.chart-card{background:var(--card);border-radius:8px;padding:14px;box-shadow:0 2px 6px rgba(0,0,0,.07);}
.chart-card.full{grid-column:1/-1;}
.chart-title{font-size:12px;font-weight:700;color:var(--pr);margin-bottom:4px;text-align:center;}
.chart-hint{font-size:10px;color:var(--sc);text-align:center;margin-bottom:8px;font-style:italic;}
canvas{max-height:260px;}
.donut-hole-wrap{position:relative;height:260px;}
.donut-hole-center{position:absolute;transform:translate(-50%,-50%);text-align:center;pointer-events:none;white-space:nowrap;}
.donut-hole-center .v{font-size:15px;font-weight:800;color:var(--pr);line-height:1.15;}
.donut-hole-center .l{font-size:9px;color:var(--txtl);margin-top:2px;}
/* ── Tables ── */
.table-card{background:var(--card);border-radius:8px;padding:14px;box-shadow:0 2px 6px rgba(0,0,0,.07);overflow-x:auto;margin-bottom:18px;}
.table-card.scroll-12{max-height:420px;overflow-y:auto;}
.table-card.scroll-12 thead th{position:sticky;top:0;z-index:1;}
table{width:100%;border-collapse:collapse;font-size:11.5px;}
th{background:var(--pr);color:var(--sc);padding:7px 9px;text-align:center;font-weight:700;white-space:nowrap;}
th.lbl{text-align:left;}
td{padding:5px 9px;border-bottom:1px solid var(--bdr);text-align:right;white-space:nowrap;}
td.lbl{text-align:left;white-space:normal;}
tr:hover td{background:rgba(245,166,35,.05);}
tr.tot td{background:#FFF9E6;font-weight:700;border-top:2px solid var(--sc);}
tr.hrow td{background:#F0E0CC;font-weight:700;}
tr.nrow td{background:#FFD700;color:var(--pr);font-weight:700;}
tr.crow td{background:#FFF3CC;font-weight:700;font-style:italic;}
tr.dim td{opacity:.25;}
tr.hl td{background:rgba(245,166,35,.18)!important;}
.pos{color:var(--pos);font-weight:600;}.neg{color:var(--neg);font-weight:600;}
.badge{display:inline-block;padding:1px 7px;border-radius:10px;font-size:10px;font-weight:700;}
.bu{background:#E8F8F0;color:var(--pos);}.bd{background:#FDEDEC;color:var(--neg);}
/* ── CF table stacked cells ── */
.cfc{min-width:100px;padding:4px 8px;vertical-align:top;}
.kv{display:block;font-size:9.5px;color:#aaa;}
.kv::before{content:'KH ';font-weight:700;color:#bbb;}
.tv{display:block;font-size:11px;font-weight:700;}
.tv::before{content:'TT ';font-weight:400;font-size:10px;color:#aaa;}
.tv.rg{color:var(--pos);}.tv.rb{color:var(--neg);}
.tv.cg{color:var(--pos);}.tv.cb{color:var(--neg);}
.tv.na{color:#ccc;font-style:italic;font-weight:400;}
.tv.zero{color:#999;}
.tv .pp{font-size:9px;font-weight:400;opacity:.75;margin-left:3px;background:rgba(0,0,0,.07);padding:1px 3px;border-radius:2px;}
/* ── CF filter ── */
.cf-filter{display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding:10px 14px;background:#FBF7EF;border:1px solid var(--bdr);border-radius:6px;margin-bottom:12px;}
.cf-filter label{font-size:11px;color:var(--pr);font-weight:700;margin-right:4px;}
.mf-btn{padding:4px 10px;border:1px solid var(--bdr);border-radius:3px;background:#fff;color:var(--txtl);font-size:11px;cursor:pointer;transition:.15s;}
.mf-btn:hover{border-color:var(--sc);color:var(--sc);}
.mf-btn.active{background:var(--pr);color:var(--sc);border-color:var(--pr);}
.mf-btn.ytd{background:#E8F8F0;color:var(--pos);border-color:var(--pos);}
.mf-sep{width:1px;height:20px;background:var(--bdr);margin:0 4px;}
/* ── Interaction ── */
.filter-badge{display:inline-flex;align-items:center;gap:6px;background:#FFF3CC;border:1px solid var(--sc);border-radius:4px;padding:2px 8px;font-size:11px;font-weight:600;color:var(--pr);}
.reset-btn{background:var(--neg);color:#fff;border:none;padding:2px 8px;border-radius:3px;cursor:pointer;font-size:10px;font-weight:700;}
.reset-btn:hover{background:#C0392B;}
#cf-col-css{display:none;}
/* ── Project Summary Table ── */
.ps-thead-top th{font-size:11px;padding:6px 8px;}
.ps-thead-sub th{font-size:10px;padding:4px 8px;font-weight:600;}
.ps-proj-row td{font-weight:700;font-size:12px;border-top:2px solid var(--bdr);}
.ps-name{font-size:12px;font-weight:800;color:var(--pr);}
.ps-toggle{display:inline-flex;align-items:center;justify-content:center;width:17px;height:17px;border-radius:3px;border:1.5px solid var(--pr);background:transparent;color:var(--pr);font-size:13px;font-weight:900;cursor:pointer;margin-right:7px;line-height:1;padding:0;transition:.15s;vertical-align:middle;}
.ps-toggle:hover{background:var(--pr);color:#fff;}
.ps-sub-row td{background:#FAFAFA;font-size:11px;border-bottom:1px solid #F0EBE0;}
.ps-sub-row td:first-child{border-left:4px solid transparent;}
.ps-sub-row:hover td{background:#F5F0E5!important;}
.ps-detail{padding-left:18px!important;font-style:italic;color:var(--txtl);}
.ps-blank{color:#DDD!important;text-align:center!important;}
.ps-rev-kh{background:rgba(27,58,107,.05);}
.ps-rev-tt{background:rgba(41,128,185,.07);color:#1A5276;font-weight:700;}
.ps-cst-kh{background:rgba(245,166,35,.06);}
.ps-cst-tt{background:rgba(245,166,35,.13);color:#B26A00;font-weight:700;}
.ps-net-kh{background:rgba(20,90,50,.05);font-weight:600;}
.ps-net-tt{background:rgba(20,90,50,.08);font-weight:700;}
.ps-pct{font-size:12px;font-weight:800;text-align:center!important;}
.ps-ctrl{font-size:11px;color:var(--sc);cursor:pointer;margin-left:10px;font-weight:600;text-decoration:underline;}
/* ── Page 4 – Nhà thầu ── */
.sub-nav{display:flex;gap:0;border-bottom:2px solid var(--bdr);margin-bottom:16px;background:#fff;border-radius:8px 8px 0 0;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.07);}
.sub-btn{padding:10px 22px;color:var(--txtl);font-weight:600;cursor:pointer;border:none;background:transparent;font-size:12px;border-bottom:3px solid transparent;margin-bottom:-2px;transition:.2s;}
.sub-btn:hover{color:var(--pr);background:rgba(27,58,107,.04);}
.sub-btn.active{color:var(--pr);border-bottom-color:var(--pr);background:rgba(27,58,107,.06);}
.sub-page{display:none;}
.mx-ctrls{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;}
.mx-btn{padding:5px 12px;border:1px solid var(--bdr);border-radius:4px;background:#fff;color:var(--pr);font-size:11px;font-weight:600;cursor:pointer;}
.mx-btn:hover{border-color:var(--sc);color:#B26A00;}
.mx-btn:focus-visible,.mx-tog:focus-visible{outline:2px solid var(--sc);outline-offset:1px;}
.mx-tog{display:inline-flex;align-items:center;justify-content:center;width:17px;height:17px;border-radius:3px;border:1.5px solid var(--pr);background:transparent;color:var(--pr);font-size:13px;font-weight:900;cursor:pointer;margin-right:7px;line-height:1;padding:0;vertical-align:middle;}
.mx-tog:hover{background:var(--pr);color:#fff;}
.mx-tog-sp{display:inline-block;width:24px;}
#tNTGrp td:not(.lbl){text-align:right;}
#tNTGrp td:nth-child(2),#tNTGrp td:nth-child(3){text-align:center;}
tr.mx-l0 td{background:#F0E0CC;font-weight:700;}
tr.mx-l1 td{font-weight:600;}
tr.mx-l1 td.lbl{padding-left:24px;}
tr.mx-l2 td{background:#FAFAFA;font-size:11px;}
tr.mx-l2 td.lbl{padding-left:62px;}
.sub-page.active{display:block;}
.nt-filter{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:10px 14px;background:#FBF7EF;border:1px solid var(--bdr);border-radius:6px;margin-bottom:14px;}
.nt-filter label{font-size:11px;color:var(--pr);font-weight:700;}
.nt-filter select{padding:6px 12px;border:1.5px solid var(--sc);border-radius:4px;background:#fff;color:var(--txt);font-weight:600;font-size:12px;cursor:pointer;min-width:230px;}
.nt-summary-cards{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:14px;}
.nt-card{background:#fff;border-radius:8px;padding:12px 18px;box-shadow:0 2px 6px rgba(0,0,0,.07);border-left:4px solid var(--pr);min-width:160px;}
.nt-card.sc{border-left-color:var(--sc);}
.nt-card.gr{border-left-color:var(--pos);}
.nt-card.vi{border-left-color:#8E44AD;}
.nt-card-lbl{font-size:9.5px;text-transform:uppercase;letter-spacing:.5px;color:var(--txtl);margin-bottom:4px;font-weight:600;}
.nt-card-val{font-size:22px;font-weight:800;color:var(--txt);line-height:1.2;}
.nt-card-sub{font-size:10px;color:var(--txtl);margin-top:2px;}
.nt-chip{display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;background:#EEF2FF;color:#1B3A6B;margin:1px;}
/* ── Page 5 – Wework (card-flow design) ── */
.wwx-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:18px;}
.wwx-head.wwx-head-only-select{justify-content:flex-end;}
.wwx-eyebrow{font-size:10.5px;font-weight:800;letter-spacing:1px;color:#4F46E5;text-transform:uppercase;margin-bottom:4px;}
.wwx-title{font-size:21px;font-weight:800;color:#111827;line-height:1.25;}
.wwx-subtitle{font-size:12px;color:#6B7280;margin-top:4px;}
.wwx-head-r{text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:6px;}
.wwx-select{padding:7px 12px;border:1px solid #E5E7EB;border-radius:7px;background:#fff;color:#111827;font-weight:600;font-size:12px;cursor:pointer;box-shadow:0 1px 2px rgba(0,0,0,.04);}
.wwx-source{font-size:10.5px;color:#9CA3AF;}
.wwx-source i{font-style:italic;}

.wwx-kpi-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-bottom:16px;}
.wwx-kpi{background:#fff;border-radius:14px;box-shadow:0 1px 3px rgba(16,24,40,.06);padding:16px 16px;position:relative;border:1px solid #F0F1F4;}
.wwx-kpi-top{display:flex;align-items:flex-start;justify-content:space-between;}
.wwx-kpi-lbl{font-size:12px;color:#6B7280;font-weight:600;}
.wwx-icon{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;}
.wwx-icon.ic-purple{background:#F1EEFE;color:#7C3AED;}
.wwx-icon.ic-green{background:#E9F9EF;color:#1E9E5A;}
.wwx-icon.ic-red{background:#FDEEEE;color:#E0342A;}
.wwx-icon.ic-blue{background:#EAF2FE;color:#2563EB;}
.wwx-icon.ic-amber{background:#FEF6E7;color:#B26A00;}
.wwx-kpi-val{font-size:26px;font-weight:800;color:#111827;margin-top:8px;line-height:1;}
.wwx-kpi-sub{font-size:11px;color:#9CA3AF;margin-top:6px;}

.wwx-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;}
.wwx-col-60,.wwx-col-40,.wwx-col-50{min-width:0;}
.wwx-link{color:#2563EB;text-decoration:none;font-weight:700;}
.wwx-link:hover{text-decoration:underline;}

.wwx-filterbar{align-items:center;gap:8px;flex-wrap:wrap;background:#EEF1FF;border:1px solid #DCE1FA;border-radius:10px;padding:8px 12px;margin-bottom:14px;}
.wwx-fb-lbl{font-size:11.5px;font-weight:700;color:#4F46E5;}
.wwx-chip{display:inline-flex;align-items:center;gap:6px;background:#fff;border:1px solid #D9DEF5;border-radius:20px;padding:3px 6px 3px 10px;font-size:11.5px;color:#374151;}
.wwx-chip b{color:#111827;}
.wwx-chip button{border:none;background:#EEF1FF;color:#4F46E5;width:16px;height:16px;border-radius:50%;font-size:10px;cursor:pointer;line-height:1;}
.wwx-chip button:hover{background:#4F46E5;color:#fff;}
.wwx-fb-clear{margin-left:auto;border:none;background:none;color:#E0342A;font-size:11px;font-weight:700;cursor:pointer;text-decoration:underline;}
.wwx-clickable{cursor:pointer;}

.wwx-alerts{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px;}
.wwx-alert-card{display:flex;align-items:center;gap:12px;background:#fff;border-radius:12px;box-shadow:0 1px 3px rgba(16,24,40,.06);padding:14px 18px;border:1px solid #F0F1F4;}
.wwx-alert-card.wwx-alert-main{border-color:#F6C2BE;background:#FFF9F8;}
.wwx-alert-card.wwx-alert-main .wwx-alert-ic{background:#E0342A;color:#fff;}
.wwx-alert-card.wwx-alert-main .wwx-alert-text{font-weight:700;color:#8B1E1E;}
.wwx-alert-card.wwx-alert-main .wwx-alert-text b{font-size:14px;}
.wwx-alert-ic{width:28px;height:28px;border-radius:50%;background:#FDEEEE;color:#E0342A;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;flex-shrink:0;}
.wwx-alert-text{font-size:12.5px;color:#374151;line-height:1.4;}
.wwx-alert-text b{color:#E0342A;font-weight:800;}

.wwx-canvas-wrap{position:relative;height:260px;flex:1;}
.wwx-card{background:#fff;border-radius:14px;box-shadow:0 1px 3px rgba(16,24,40,.06);padding:18px 20px;border:1px solid #F0F1F4;display:flex;flex-direction:column;}
.wwx-card-top,.wwx-card-title,.wwx-card-sub{flex-shrink:0;}
.wwx-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:2px;}
.wwx-card-title{font-size:14px;font-weight:800;color:#111827;}
.wwx-card-sub{font-size:11.5px;color:#9CA3AF;margin-bottom:14px;margin-top:2px;}
.wwx-badge-over{display:inline-block;padding:3px 10px;border-radius:8px;font-size:11px;font-weight:700;background:#FDEEEE;color:#E0342A;white-space:nowrap;}
.wwx-badge-pill{display:inline-block;padding:3px 10px;border-radius:8px;font-size:11px;font-weight:700;background:#EEF1FF;color:#4F46E5;white-space:nowrap;}

.wwx-overall-body{display:flex;align-items:center;gap:8px;flex-wrap:wrap;flex:1;min-height:260px;}
.wwx-donut-col{flex:0 0 auto;width:38%;min-width:200px;display:flex;align-items:center;justify-content:center;}
.wwx-donut-wrap{position:relative;width:190px;height:190px;flex-shrink:0;}
.wwx-donut-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
.wwx-donut-pct{font-size:32px;font-weight:800;color:#111827;line-height:1;}
.wwx-donut-lbl{font-size:11.5px;color:#9CA3AF;margin-top:5px;}
.wwx-overall-right{flex:1;min-width:220px;}
.wwx-overall-head{display:flex;justify-content:space-between;font-size:11.5px;font-weight:700;color:#374151;margin-bottom:8px;}
