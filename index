  // Table: group by category, detail by project
  let rows='';
  catList.forEach((cat,ci)=>{
    const cRecs=recs.filter(r=>r.cat===cat);
    const pj=[...new Set(cRecs.map(r=>r.proj))];
    const cP=d.months.map((_,i)=>cRecs.reduce((s,r)=>s+(r.p[i]||0),0));
    const cA=d.months.map((_,i)=>{const vs=cRecs.map(r=>r.a[i]);return vs.every(v=>isNA(v))?null:vs.filter(v=>!isNA(v)).reduce((s,v)=>s+(v||0),0);});
    const cGP=SP(cP), cGA=SA(cA.filter(v=>!isNA(v)));
    const cPct=cGP?`<span class="${cGA<=cGP?'pos':'neg'}">${PCT(cGA,cGP)}</span>`:'—';
    rows+=`<tr class="hrow">
      <td class="lbl" style="font-size:12px;font-weight:800;border-left:4px solid ${NT_COLORS[ci%NT_COLORS.length]}">
