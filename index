// ── Utilities ─────────────────────────────────────────────────────────────────
const SA  = a => a.filter(v => v!==null && v!==undefined).reduce((s,v)=>s+(v||0),0);
const SP  = a => a.reduce((s,v)=>s+(v||0),0);
const CS  = a => { let s=0; return a.map(v=>v===null?null:(s+=v,s)); };
const N   = v => new Intl.NumberFormat('vi-VN').format(Math.round(v));
const NM  = v => N(v*1_000_000);
const PCT = (a,p) => p ? (a/p*100).toFixed(1)+'%' : '—';
const isNA= v => v===null||v===undefined;

function NA(v){ return isNA(v)? '—' : v===0 ? '0' : NM(v); }

// Overlays a value in the hole of a doughnut chart whose legend sits beside the
// ring (position:'right'), so the ring's true center is off-center in the canvas —
// read it from the arc element each draw instead of assuming 50%/50%.
function donutCenterPlugin(centerId, labelFn){
  return {
    id: 'donutCenter_'+centerId,
    afterDraw(chart){
      const el = document.getElementById(centerId);
      if(!el) return;
      const arc = chart.getDatasetMeta(0).data[0];
      if(!arc){ el.innerHTML=''; return; }
      el.style.left = arc.x+'px';
      el.style.top = arc.y+'px';
      el.innerHTML = labelFn(chart);
    }
  };
}

// CF stacked cell — mn = month number (1-based) for column class
function CFC(pv, av, isRev, mn){
  const p = pv||0;
  const na = isNA(av);
  let cls='na', pct='';
  if(!na){
    const good = isRev ? av>=p : av<=p;
    cls = av===0 ? 'zero' : (good ? (isRev?'rg':'cg') : (isRev?'rb':'cb'));
    if(p>0 && av>0) pct = `<span class="pp">${(av/p*100).toFixed(0)}%</span>`;
  }
  return `<td class="cfc mc-${mn||0}">
    <span class="kv">${NM(p)}</span>
    <span class="tv ${cls}">${NA(av)}${pct}</span>
  </td>`;
}

// CF stacked total cell (no month class)
function CFCT(pv, av, isRev){
  const p = pv||0; const na=isNA(av);
  let cls='na', pct='';
  if(!na){
    const good = isRev ? av>=p : av<=p;
    cls = av===0?'zero':(good?(isRev?'rg':'cg'):(isRev?'rb':'cb'));
    if(p>0&&av>0) pct=`<span class="pp">${(av/p*100).toFixed(0)}%</span>`;
  }
  return `<td class="cfc">
    <span class="kv">${NM(p)}</span>
    <span class="tv ${cls}">${NA(av)}${pct}</span>
  </td>`;
}

