  const mTP=d.months.map((_,i)=>recs.reduce((s,r)=>s+(r.p[i]||0),0));
  const mTA=d.months.map((_,i)=>{const vs=recs.map(r=>r.a[i]);return vs.every(v=>isNA(v))?null:vs.filter(v=>!isNA(v)).reduce((s,v)=>s+(v||0),0);});
  rows+=`<tr class="tot">
    <td class="lbl" colspan="2">TỔNG CỘNG</td>
    <td>${N(grandP)}</td><td>${N(grandA)}</td>
    <td><span class="${grandA<=grandP?'pos':'neg'}">${PCT(grandA,grandP)}</span></td>
