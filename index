    <td class="ps-net-tt ${totNA>=totNP?'pos':'neg'}">${N(totNA)}</td>
    <td class="${totDelta>=0?'pos':'neg'}">${totDelta>=0?'+':''}${N(totDelta)}</td>
    <td class="ps-pct ${totPct>=100?'pos':'neg'}">${totPct!==null?totPct+'%':'—'}</td>
  </tr>`;

  document.getElementById('tProjSummary').innerHTML = `
  <thead>
    <tr class="ps-thead-top">
      <th class="lbl" rowspan="2" style="min-width:130px">Dự án</th>
