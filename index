      }).join('')}
    </tr>`;
    cRecs.forEach(r=>{
      const rP=SP(r.p), rA=SA(r.a.filter(v=>!isNA(v)));
      const rPct=rP?`<span class="${rA<=rP?'pos':'neg'}">${PCT(rA,rP)}</span>`:'—';
      rows+=`<tr>
        <td class="lbl" style="padding-left:20px;font-style:italic;font-size:11px;border-left:4px solid ${NT_COLORS[ci%NT_COLORS.length]}22">
          ${r.proj}
