    <th style="min-width:68px;">% Thực hiện</th>
    ${d.months.map((m,i)=>`<th style="min-width:64px;">${m}${i<d.ac?' ✓':''}<br><span style="font-weight:400;font-size:9px;">TT / KH</span></th>`).join('')}
  </tr></thead><tbody>${rows}</tbody>`;
}

// ── Page 5 – Wework tiến độ (BI report flow, cross-filter) ───────────────────
let wwxScope = ''; // '' = tất cả dự án, else = tên dự án (đồng bộ với dropdown)
let wwxFilters = { status:null, dept:null, assignee:null };
const wwxFmtDate = iso => iso ? iso.split('-').reverse().join('/') : '—';
const wwxDim = hex => hex + '30'; // ~19% alpha, dùng để làm mờ lựa chọn không được chọn

// Trả về tập công việc thoả mọi bộ lọc đang bật, TRỪ chiều `exclude` (để chart của
// chính chiều đó luôn hiển thị đủ các hạng mục cho người dùng bấm chọn/đổi lựa chọn).
function wwxFilteredTasks(exclude){
  return WEWORK2.filter(t =>
    (exclude==='proj'     || !wwxScope           || t.proj===wwxScope) &&
    (exclude==='status'   || !wwxFilters.status  || t.status===wwxFilters.status) &&
    (exclude==='dept'     || !wwxFilters.dept    || t.dept===wwxFilters.dept) &&
    (exclude==='assignee' || !wwxFilters.assignee|| t.assignee===wwxFilters.assignee)
  );
}

// Chỉ có một bộ lọc "Dự án" duy nhất trên toàn báo cáo (dropdown ở header) —
// đổi scope ở đây đồng thời đồng bộ ngược lại dropdown đó và bộ lọc doanh thu/chi phí.
function wwxSetScope(v){
  wwxScope = v || '';
  filterByProject(wwxScope || null, false);
  renderP5();
}
function wwxToggleFilter(key, value){
  wwxFilters[key] = (wwxFilters[key]===value) ? null : value;
  renderP5();
}
function wwxRemoveFilter(key){
  if(key==='proj') wwxSetScope('');
  else { wwxFilters[key] = null; renderP5(); }
}
function wwxClearAllFilters(){
  wwxFilters = { status:null, dept:null, assignee:null };
  wwxSetScope('');
}

function renderWwxFilterbar(){
  const chips = [];
  if(wwxScope) chips.push({key:'proj', label:'Dự án', value:wwxScope});
  if(wwxFilters.status) chips.push({key:'status', label:'Trạng thái', value:wwxFilters.status});
  if(wwxFilters.dept) chips.push({key:'dept', label:'Phòng ban', value:wwxFilters.dept});
  if(wwxFilters.assignee) chips.push({key:'assignee', label:'Nhân sự', value:wwxFilters.assignee});
  const el = document.getElementById('wwx-filterbar');
  if(!chips.length){ el.style.display='none'; el.innerHTML=''; return; }
  el.style.display='flex';
  el.innerHTML = `
    <span class="wwx-fb-lbl">🔗 Đang lọc chéo:</span>
    ${chips.map(c=>`<span class="wwx-chip">${c.label}: <b>${c.value}</b><button onclick="wwxRemoveFilter('${c.key}')">✕</button></span>`).join('')}
    <button class="wwx-fb-clear" onclick="wwxClearAllFilters()">Xóa tất cả</button>`;
}

