function renderRevMonthTable(){
  const d=D[CY];
  const towers = Object.entries(TOWER_META).filter(([,meta]) => !selProj || meta.project===selProj);
  let rows='', totUnits=0, totVal=0, totPlan=0;
  d.fm.forEach((m,i)=>{
    towers.forEach(([towerName, meta])=>{
      const projA = d.revProj[meta.project]; // tổng năm của dự án (để tính tỉ trọng tòa)
      const towerA = d.revTower[towerName];  // tổng năm của tòa
      const shareP = projA.p ? towerA.p/projA.p : 0;
      const shareA = projA.a ? towerA.a/projA.a : 0;
      const proj = d.revByProj[meta.project];
      const planVal = Math.round((proj.p[i]||0)*shareP);
      const rawA = proj.a[i];
      const na = isNA(rawA);
      const actVal = na ? null : Math.round(rawA*shareA);
      const units = na ? null : Math.round(actVal/meta.price);
      const pctAch = na ? null : (planVal ? Math.round(actVal/planVal*100) : null);
      totPlan += planVal;
      if(!na){ totVal += actVal; totUnits += units; }
      rows+=`<tr>
        <td class="lbl">${m}${i>=d.ac?' <span style="font-size:10px;color:#bbb;">(KH)</span>':''}</td>
        <td class="lbl">${meta.project}</td>
        <td class="lbl">${towerName}</td>
        <td class="lbl">${meta.seller} <span style="font-size:9px;color:var(--txtl)">(${meta.sellerType})</span></td>
        <td>${na?'—':N(units)}</td>
        <td>${na?'—':N(actVal)}</td>
        <td>${N(planVal)}</td>
        <td>${na?'—':(pctAch===null?'—':`<span class="${pctAch>=100?'pos':'neg'}">${pctAch}%</span>`)}</td>
      </tr>`;
    });
  });
  document.getElementById('tRevMonth').innerHTML=`<thead><tr>
    <th class="lbl">Tháng</th><th class="lbl">Dự án</th><th class="lbl">Căn (Tòa)</th><th class="lbl">Nhân sự bán / Đại lý bán</th>
    <th>Số căn bán</th><th>Tổng giá trị bán (triệu)</th><th>Kế hoạch (triệu)</th><th>Tỉ lệ đạt so KH</th>
  </tr></thead><tbody>${rows}
  <tr class="tot"><td class="lbl" colspan="4">TỔNG CỘNG</td>
    <td>${N(totUnits)}</td><td>${N(totVal)}</td><td>${N(totPlan)}</td>
    <td>${PCT(totVal,totPlan)}</td>
  </tr></tbody>`;
}

