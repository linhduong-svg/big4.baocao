    const totA=d.months.map((_,i)=>{const vs=recs.map(r=>r.a[i]);return vs.every(v=>isNA(v))?null:vs.filter(v=>!isNA(v)).reduce((s,v)=>s+(v||0),0);});
    dC('cNTNTMonthly');
