// ── Project Summary Table ─────────────────────────────────────────────────────
function toggleProj(name){
  const btn = document.querySelector(`[data-proj="${name}"] .ps-toggle`);
  const rows = document.querySelectorAll(`[data-proj-detail="${name}"]`);
  const open = btn.textContent.trim() === '−';
  rows.forEach(r => { r.style.display = open ? 'none' : ''; });
  btn.textContent = open ? '+' : '−';
}
function setProjAll(expand){
  const d = D[CY];
  d.projData.forEach(p => {
    const btn = document.querySelector(`[data-proj="${p.name}"] .ps-toggle`);
    const rows = document.querySelectorAll(`[data-proj-detail="${p.name}"]`);
    if(!btn) return;
    rows.forEach(r => { r.style.display = expand ? '' : 'none'; });
    btn.textContent = expand ? '−' : '+';
  });
}

function renderProjSummary(){
  const d = D[CY];
  const projs = d.projData;
  const yrLbl = CY===2026 ? 'Năm 2026 (Thu/Chi TT: T1–T7)' : 'Năm 2025 (Cả năm)';
  document.getElementById('ps-yr-lbl').textContent = yrLbl;

  const PROJ_COLORS = {'La Pura':'#FFF4EE','Demo A':'#EEF5FF','Demo B':'#F0FFF4'};
  const PROJ_ACC    = {'La Pura':'#1B3A6B','Demo A':'#1A5276','Demo B':'#145A32'};

  let rows = '';
  projs.forEach(p => {
    const netP = p.revP - p.cstP;
    const netA = p.revA - p.cstA;
    const delta = netA - netP;
    const pct = netP !== 0 ? Math.round(netA / netP * 100) : null;
    const pctCls = pct === null ? '' : pct >= 100 ? 'pos' : 'neg';
    const bg = PROJ_COLORS[p.name] || '#fff';
    const acc = PROJ_ACC[p.name] || '#555';

    // Project summary row (no rowspan — toggle controls sub-rows)
    rows += `<tr class="ps-proj-row" data-proj="${p.name}" style="background:${bg}">
      <td class="ps-name lbl" style="border-left:4px solid ${acc};white-space:nowrap">
        <button class="ps-toggle" onclick="toggleProj('${p.name}')">+</button>${p.name}
      </td>
      <td class="lbl" style="font-size:11px;color:#888;font-style:italic">— Tổng —</td>
      <td class="ps-rev-kh">${N(p.revP)}</td>
      <td class="ps-rev-tt">${N(p.revA)}</td>
      <td class="ps-cst-kh">${N(p.cstP)}</td>
      <td class="ps-cst-tt">${N(p.cstA)}</td>
      <td class="ps-net-kh">${N(netP)}</td>
      <td class="ps-net-tt ${netA>=netP?'pos':'neg'}">${N(netA)}</td>
      <td class="${delta>=0?'pos':'neg'}">${delta>=0?'+':''}${N(delta)}</td>
      <td class="ps-pct ${pctCls}">${pct!==null?pct+'%':'—'}</td>
    </tr>`;

    // Revenue detail rows
    p.revDetail.forEach(r => {
      rows += `<tr class="ps-sub-row" data-proj-detail="${p.name}" style="background:${bg};display:none"
        <td style="border-left:4px solid ${acc}"></td>
        <td class="lbl ps-detail">${r.n}</td>
        <td class="ps-rev-kh">${N(r.p)}</td>
        <td class="ps-rev-tt">${N(r.a)}</td>
        <td class="ps-blank">—</td><td class="ps-blank">—</td>
        <td class="ps-blank">—</td><td class="ps-blank">—</td>
        <td class="ps-blank">—</td><td class="ps-blank">—</td>
      </tr>`;
    });

    // Cost detail rows
    p.cstDetail.forEach(c => {
      rows += `<tr class="ps-sub-row" data-proj-detail="${p.name}" style="background:${bg};display:none"
        <td style="border-left:4px solid ${acc}"></td>
        <td class="lbl ps-detail">${c.n}</td>
        <td class="ps-blank">—</td><td class="ps-blank">—</td>
        <td class="ps-cst-kh">${N(c.p)}</td>
        <td class="ps-cst-tt">${N(c.a)}</td>
        <td class="ps-blank">—</td><td class="ps-blank">—</td>
        <td class="ps-blank">—</td><td class="ps-blank">—</td>
      </tr>`;
    });
  });

  // Total row
  const totRP = projs.reduce((s,p)=>s+p.revP,0), totRA = projs.reduce((s,p)=>s+p.revA,0);
  const totCP = projs.reduce((s,p)=>s+p.cstP,0), totCA = projs.reduce((s,p)=>s+p.cstA,0);
  const totNP = totRP-totCP, totNA = totRA-totCA;
  const totDelta = totNA-totNP;
  const totPct = totNP!==0 ? Math.round(totNA/totNP*100) : null;

  rows += `<tr class="tot">
