function toggleCF(group){
  const btn = document.querySelector(`[data-cf-grp="${group}"] .ps-toggle`);
  const rows = document.querySelectorAll(`[data-cf-detail="${group}"]`);
  const open = btn.textContent.trim() === '−';
  rows.forEach(r => { r.style.display = open ? 'none' : ''; });
  btn.textContent = open ? '+' : '−';
}
function setCFAll(expand){
