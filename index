// ── Sub-view 2: Tổng hợp theo Hạng mục (Nhu cầu 2) ──────────────────────────
function renderNTGrpView(){
  const recs = NT_DATA[CY];
  const allNTs = [...new Set(recs.map(r=>r.nt))];
  const allCats = [...new Set(recs.map(r=>r.cat))];
  const totalA = recs.reduce((s,r)=>s+SA(r.a.filter(v=>!isNA(v))),0);
  const totalP = recs.reduce((s,r)=>s+SP(r.p),0);

  document.getElementById('nt-grp-summary').innerHTML=`
    <div class="nt-card">
      <div class="nt-card-lbl">Tổng nhà thầu</div>
      <div class="nt-card-val">${allNTs.length}</div>
      <div class="nt-card-sub">nhà thầu đang hoạt động</div>
    </div>
    <div class="nt-card sc">
      <div class="nt-card-lbl">Hạng mục có nhà thầu</div>
      <div class="nt-card-val">${allCats.length}</div>
      <div class="nt-card-sub">trên tổng 10 hạng mục chi</div>
    </div>
    <div class="nt-card gr">
      <div class="nt-card-lbl">Tổng chi TT</div>
      <div class="nt-card-val" style="font-size:16px;">${N(totalA)} tr</div>
      <div class="nt-card-sub">KH: ${N(totalP)} tr &nbsp;|&nbsp; đạt ${totalP?((totalA/totalP*100).toFixed(1)+'%'):'—'}</div>
    </div>`;

  // Group categories by grp
  const catMap = D[CY].cstCat;
  const grpOrder=['BRANDING','MKT BÁN HÀNG','QUỸ DỰ PHÒNG'];
  const grpLabel={'BRANDING':'A. BRANDING','MKT BÁN HÀNG':'B. MKT BÁN HÀNG','QUỸ DỰ PHÒNG':'C. QUỸ DỰ PHÒNG'};

  // Matrix: Nhóm > Hạng mục > Hợp đồng, xổ xuống / thu gọn
  const pctSpan=(a,p)=>p?`<span class="${a<=p?'pos':'neg'}">${PCT(a,p)}</span>`:'—';
  const sumP=rs=>rs.reduce((s,r)=>s+SP(r.p),0);
  const sumA=rs=>rs.reduce((s,r)=>s+SA(r.a.filter(v=>!isNA(v))),0);
  const tog=(key,has)=>has
    ? `<button class="mx-tog" onclick="ntgToggle('${key.replace(/'/g,"\\'")}')" aria-expanded="${!ntgCollapsed.has(key)}">${ntgCollapsed.has(key)?'+':'−'}</button>`
    : '<span class="mx-tog-sp"></span>';
  let rows='';
  grpOrder.forEach(grp=>{
    const grpCats=Object.entries(catMap).filter(([,v])=>v.g===grp);
    if(!grpCats.length) return;
    const grpRecs=recs.filter(r=>r.grp===grp);
    const gKey='g|'+grp;
    const gP=sumP(grpRecs), gA=sumA(grpRecs);
    rows+=`<tr class="mx-l0">
      <td class="lbl">${tog(gKey,true)}<b>${grpLabel[grp]}</b></td>
      <td>${new Set(grpRecs.map(r=>r.nt)).size||'—'}</td>
      <td>${new Set(grpRecs.map(r=>r.proj)).size||'—'}</td>
      <td>${N(gP)}</td><td>${N(gA)}</td><td>${pctSpan(gA,gP)}</td></tr>`;
    if(ntgCollapsed.has(gKey)) return;
    grpCats.forEach(([catName])=>{
      const cRecs=recs.filter(r=>r.cat===catName);
      const ntSet=[...new Set(cRecs.map(r=>r.nt))];
      const cKey='c|'+catName;
      const cP=cRecs.length?sumP(cRecs):0, cA=cRecs.length?sumA(cRecs):0;
      rows+=`<tr class="mx-l1">
        <td class="lbl">${tog(cKey,ntSet.length>0)}${catName}</td>
        <td>${ntSet.length||'—'}</td>
        <td>${new Set(cRecs.map(r=>r.proj)).size||'—'}</td>
        <td>${N(cP)}</td><td>${N(cA)}</td><td>${pctSpan(cA,cP)}</td></tr>`;
      if(ntgCollapsed.has(cKey)) return;
      ntSet.forEach((n,i)=>{
        const nRecs=cRecs.filter(r=>r.nt===n);
        const nP=sumP(nRecs), nA=sumA(nRecs);
        const col=NT_COLORS[i%NT_COLORS.length];
        rows+=`<tr class="mx-l2">
          <td class="lbl"><span class="nt-chip" style="background:${col}22;color:${col};">${n}</span></td>
          <td></td>
          <td>${new Set(nRecs.map(r=>r.proj)).size}</td>
          <td>${N(nP)}</td><td>${N(nA)}</td><td>${pctSpan(nA,nP)}</td></tr>`;
      });
    });
  });
  const tP=sumP(recs), tA=sumA(recs);
  rows+=`<tr class="tot"><td class="lbl">TỔNG CỘNG</td>
    <td>${new Set(recs.map(r=>r.nt)).size}</td><td>${new Set(recs.map(r=>r.proj)).size}</td>
    <td>${N(tP)}</td><td>${N(tA)}</td><td>${pctSpan(tA,tP)}</td></tr>`;

  document.getElementById('tNTGrp').innerHTML=`<thead><tr>
    <th class="lbl" style="min-width:300px;">Nhóm / Hạng mục / Hợp đồng</th>
    <th style="min-width:55px;">Số NT</th>
    <th style="min-width:55px;">Số DA</th>
    <th style="min-width:80px;">KH</th>
    <th style="min-width:80px;">TT</th>
    <th style="min-width:75px;">% TH</th>
  </tr></thead><tbody>${rows}</tbody>`;
}

// Trạng thái xổ/thu của bảng Tổng hợp Hạng mục
const ntgCollapsed = new Set();
function ntgToggle(key){
